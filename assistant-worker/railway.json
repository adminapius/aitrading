{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "assistant-worker/Dockerfile", "watchPatterns": ["assistant-worker/**"] },
  "deploy": { "numReplicas": 1, "healthcheckPath": "/health", "healthcheckTimeout": 30, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 10 }
}
